---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags = [], draft = false } = Astro.props;
---

<html lang="zh-Hant">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.article-header {
				margin-bottom: 3.5rem;
			}
			.post-meta {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.8rem;
				font-size: 0.9rem;
				color: var(--text-muted);
				margin-bottom: 0.6rem;
				letter-spacing: 0.03em;
			}
			.draft-badge {
				font-size: 0.75rem;
				border: 1px solid var(--border);
				padding: 0.1em 0.4em;
				border-radius: 2px;
				color: var(--text-muted);
			}
			.tags {
				display: flex;
				gap: 0.6rem;
			}
			.tag-link {
				color: var(--text-muted);
				text-decoration: none;
				font-size: 0.88rem;
				transition: opacity 0.15s ease;
			}
			.tag-link:hover {
				opacity: 0.8;
			}
			.post-title {
				margin-top: 0;
				margin-bottom: 1.5rem;
				font-size: 2.2rem;
				line-height: 1.35;
			}
			.hero-image {
				margin-bottom: 2.5rem;
			}
			.hero-image img {
				display: block;
				border-radius: 4px;
			}
			.article-content {
				line-height: 1.78;
			}
			.article-footer {
				margin-top: 4.5rem;
				padding-top: 1rem;
				border: none;
			}
			.back-link {
				color: var(--text-muted);
				text-decoration: none;
				font-size: 0.95rem;
				transition: opacity 0.15s ease;
			}
			.back-link:hover {
				opacity: 0.8;
			}

			@media (max-width: 640px) {
				.article-header {
					margin-bottom: 2.2rem;
				}
				.post-title {
					font-size: 1.75rem;
					margin-bottom: 1rem;
				}
				.article-content {
					font-size: 1rem;
					line-height: 1.72;
				}
				.article-footer {
					margin-top: 3.5rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<header class="article-header">
					<div class="post-meta">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span> · 更新於 <FormattedDate date={updatedDate} /></span>
						)}
						{draft && <span class="draft-badge">草稿</span>}
						{tags && tags.length > 0 && (
							<div class="tags">
								{tags.map((tag: string) => (
									<a href={`/tags/${tag}`} class="tag-link">
										#{tag}
									</a>
								))}
							</div>
						)}
					</div>
					<h1 class="post-title">{title}</h1>
				</header>
				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}
				<div class="article-content">
					<slot />
				</div>
				<footer class="article-footer">
					<a href="/blog" class="back-link">← 返回文章列表</a>
				</footer>
			</article>
		</main>
		<Footer />
	</body>
</html>
