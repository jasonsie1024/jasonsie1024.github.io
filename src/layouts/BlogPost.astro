---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: { depth: number; slug: string; text: string }[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroCaption,
	gallery,
	tags = [],
	draft = false,
	toc = false,
	headings = [],
} = Astro.props;

const filteredHeadings = toc
	? headings.filter(
			(h) =>
				h.depth >= 1 &&
				h.depth <= 4 &&
				h.slug !== 'footnote-label' &&
				h.text.toLowerCase() !== 'footnotes'
	  )
	: [];
const minDepth = filteredHeadings.length > 0 ? Math.min(...filteredHeadings.map((h) => h.depth)) : 1;
const showToc = toc && filteredHeadings.length > 0;
---

<html lang="zh-Hant">
	<head>
		<BaseHead title={title} description={description} image={heroImage} articleDate={pubDate} />
		<style>
			.article-header {
				margin-bottom: 2.2rem;
			}
			.post-title {
				margin-top: 0;
				margin-bottom: 0.8rem;
				font-size: 2.2rem;
				line-height: 1.35;
			}
			.post-meta {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.8rem;
				font-size: 0.9rem;
				color: var(--text-muted);
				margin-bottom: 0;
				letter-spacing: 0.03em;
			}
			.draft-badge {
				font-size: 0.75rem;
				border: 1px solid var(--border);
				padding: 0.1em 0.4em;
				border-radius: 2px;
				color: var(--text-muted);
			}
			.tags {
				display: flex;
				gap: 0.6rem;
			}
			.tag-link {
				color: var(--text-muted);
				text-decoration: none;
				font-size: 0.88rem;
				transition: opacity 0.15s ease;
			}
			.tag-link:hover {
				opacity: 0.8;
			}
			.hero-image {
				margin: 0 0 3.2rem 0;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 0;
				margin: 0;
				cursor: pointer;
			}
			.hero-caption {
				margin-top: 0.85rem;
				font-size: 0.85rem;
				color: var(--text-muted);
				text-align: right;
				letter-spacing: 0.04em;
				line-height: 1.6;
			}
			.article-content {
				line-height: 1.78;
			}
			.article-footer {
				margin-top: 4.5rem;
				padding-top: 1rem;
				border: none;
			}
			.back-link {
				color: var(--text-muted);
				text-decoration: none;
				font-size: 0.95rem;
				transition: opacity 0.15s ease;
			}
			.back-link:hover {
				opacity: 0.8;
			}

			/* 懸浮右上角 TOC 目次導覽 */
			.toc-sidebar {
				position: fixed;
				top: 6.5rem;
				left: calc(50% + (var(--content-width) / 2) + 1.25rem);
				width: 200px;
				max-height: calc(100vh - 10rem);
				overflow-y: auto;
				z-index: 90;
				padding-left: 0.9rem;
				border-left: 1px solid var(--border);
				user-select: none;
				-webkit-user-select: none;
			}
			.toc-sidebar::-webkit-scrollbar {
				width: 2px;
			}
			.toc-sidebar::-webkit-scrollbar-thumb {
				background-color: var(--border);
			}
			.toc-list {
				list-style: none;
				padding: 0;
				margin: 0;
				font-size: 0.82rem;
				line-height: 1.55;
			}
			.toc-item {
				margin-bottom: 0.55rem;
			}
			.toc-item.level-0 {
				padding-left: 0;
			}
			.toc-item.level-1 {
				padding-left: 0.75rem;
				font-size: 0.78rem;
			}
			.toc-item.level-2 {
				padding-left: 1.35rem;
				font-size: 0.76rem;
			}
			.toc-item.level-3 {
				padding-left: 1.85rem;
				font-size: 0.74rem;
			}
			.toc-link {
				color: var(--text-muted);
				text-decoration: none;
				display: block;
				transition: color 0.15s ease, opacity 0.15s ease;
				word-break: break-word;
				opacity: 0.8;
			}
			.toc-link:hover {
				color: var(--text);
				opacity: 1;
			}
			.toc-link.is-active {
				color: var(--text);
				font-weight: 600;
				opacity: 1;
			}

			/* 當螢幕寬度不足以同時容納正文（840px）與右側 TOC 時，自動隱藏 */
			@media (max-width: 1280px) {
				.toc-sidebar {
					display: none;
				}
			}

			@media (max-width: 640px) {
				.article-header {
					margin-bottom: 1.8rem;
				}
				.post-title {
					font-size: 1.75rem;
					margin-bottom: 0.6rem;
				}
				.hero-image {
					margin-bottom: 2.2rem;
				}
				.hero-caption {
					font-size: 0.82rem;
					margin-top: 0.65rem;
				}
				.article-content {
					font-size: 1rem;
					line-height: 1.72;
				}
				.article-footer {
					margin-top: 3.5rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			{showToc && (
				<aside class="toc-sidebar" aria-label="目錄">
					<nav>
						<ul class="toc-list">
							{filteredHeadings.map((heading) => {
								const level = heading.depth - minDepth;
								return (
									<li class:list={['toc-item', `level-${level}`]}>
										<a href={`#${heading.slug}`} class="toc-link" data-toc-slug={heading.slug}>
											{heading.text}
										</a>
									</li>
								);
							})}
						</ul>
					</nav>
				</aside>
			)}
			<article>
				<header class="article-header">
					<h1 class="post-title">{title}</h1>
					<div class="post-meta">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span> · 更新於 <FormattedDate date={updatedDate} /></span>
						)}
						{draft && <span class="draft-badge">草稿</span>}
						{tags && tags.length > 0 && (
							<div class="tags">
								{tags.map((tag: string) => (
									<a href={`/tags/${tag}`} class="tag-link">
										#{tag}
									</a>
								))}
							</div>
						)}
					</div>
				</header>
				{heroImage && (
					<figure class="hero-image">
						<Image src={heroImage} alt={title} />
						{heroCaption && <figcaption class="hero-caption">{heroCaption}</figcaption>}
					</figure>
				)}
				<div class="article-content">
					<slot />
				</div>
				<footer class="article-footer">
					<a href="/blog" class="back-link">← 返回文章列表</a>
				</footer>
			</article>
		</main>
		<Footer />

		<script>
			function setupImageZoom() {
				const images = document.querySelectorAll<HTMLImageElement>(
					'.hero-image img, .article-content img'
				);

				let overlay = document.querySelector<HTMLElement>('.image-zoom-overlay');
				if (!overlay) {
					overlay = document.createElement('div');
					overlay.className = 'image-zoom-overlay';
					document.body.appendChild(overlay);
				}

				let activeZoomClose: (() => void) | null = null;

				images.forEach((img) => {
					img.style.cursor = 'pointer';

					// 避免重複綁定
					if (img.dataset.zoomReady) return;
					img.dataset.zoomReady = 'true';

					img.addEventListener('click', (e) => {
						e.stopPropagation();
						if (activeZoomClose) {
							activeZoomClose();
							return;
						}

						const rect = img.getBoundingClientRect();

						// 建立放大的圖片節點（FLIP 動畫）
						const clone = document.createElement('img');
						clone.src = img.currentSrc || img.src;
						clone.alt = img.alt || '';
						clone.style.position = 'fixed';
						clone.style.left = `${rect.left}px`;
						clone.style.top = `${rect.top}px`;
						clone.style.width = `${rect.width}px`;
						clone.style.height = `${rect.height}px`;
						clone.style.margin = '0';
						clone.style.padding = '0';
						clone.style.borderRadius = '0';
						clone.style.border = 'none';
						clone.style.outline = 'none';
						clone.style.zIndex = '9995';
						clone.style.cursor = 'pointer';
						clone.style.transformOrigin = 'top left';
						clone.style.transition = 'transform 0.32s cubic-bezier(0.2, 0, 0.2, 1)';
						clone.style.willChange = 'transform';
						clone.style.display = 'block';
						clone.style.maxWidth = 'none';
						clone.style.maxHeight = 'none';
						clone.style.objectFit = 'contain';

						// 計算放大到全螢幕的尺寸：最窄邊保留約 5em（左右/上下各約 2.5em）
						const vw = window.innerWidth;
						const vh = window.innerHeight;
						const rootFs = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
						const sideMargin = Math.min(vw, vh) < 640 ? 16 : 2.5 * rootFs;
						const maxW = vw - sideMargin * 2;
						const maxH = vh - sideMargin * 2;

						const aspect = (img.naturalWidth || rect.width) / (img.naturalHeight || rect.height);
						let targetW = maxW;
						let targetH = targetW / aspect;
						if (targetH > maxH) {
							targetH = maxH;
							targetW = targetH * aspect;
						}

						const targetLeft = (vw - targetW) / 2;
						const targetTop = (vh - targetH) / 2;
						const scaleX = targetW / rect.width;
						const scaleY = targetH / rect.height;
						const transX = targetLeft - rect.left;
						const transY = targetTop - rect.top;

						img.style.visibility = 'hidden';
						document.body.appendChild(clone);

						// 顯示背景遮罩
						if (overlay) overlay.classList.add('is-active');

						// 動畫展開
						requestAnimationFrame(() => {
							clone.style.transform = `translate3d(${transX}px, ${transY}px, 0) scale(${scaleX}, ${scaleY})`;
						});

						let isClosing = false;
						const closeZoom = () => {
							if (isClosing) return;
							isClosing = true;

							const currRect = img.getBoundingClientRect();
							const closeScaleX = currRect.width / rect.width;
							const closeScaleY = currRect.height / rect.height;
							const closeTransX = currRect.left - rect.left;
							const closeTransY = currRect.top - rect.top;

							clone.style.transform = `translate3d(${closeTransX}px, ${closeTransY}px, 0) scale(${closeScaleX}, ${closeScaleY})`;
							if (overlay) overlay.classList.remove('is-active');

							let cleaned = false;
							const cleanup = () => {
								if (cleaned) return;
								cleaned = true;
								if (clone.parentNode) clone.parentNode.removeChild(clone);
								img.style.visibility = '';
								window.removeEventListener('keydown', handleKey);
								window.removeEventListener('scroll', handleScroll);
								activeZoomClose = null;
							};

							clone.addEventListener('transitionend', cleanup, { once: true });
							setTimeout(cleanup, 360);
						};

						activeZoomClose = closeZoom;

						const handleKey = (ev: KeyboardEvent) => {
							if (ev.key === 'Escape') closeZoom();
						};

						const startScrollY = window.scrollY;
						const handleScroll = () => {
							if (Math.abs(window.scrollY - startScrollY) > 40) {
								closeZoom();
							}
						};

						clone.addEventListener('click', (ev) => {
							ev.stopPropagation();
							closeZoom();
						});

						if (overlay) {
							overlay.onclick = (ev) => {
								ev.stopPropagation();
								closeZoom();
							};
						}

						window.addEventListener('keydown', handleKey);
						window.addEventListener('scroll', handleScroll, { passive: true });
					});
				});
			}

			setupImageZoom();
			document.addEventListener('astro:page-load', setupImageZoom);

			function setupTocSpy() {
				const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
				if (!tocLinks.length) return;

				const slugs = Array.from(tocLinks).map((link) => link.dataset.tocSlug);
				const headingElements = slugs
					.map((slug) => document.getElementById(slug || ''))
					.filter((el): el is HTMLElement => Boolean(el));

				if (!headingElements.length) return;

				let activeSlug = '';

				const observer = new IntersectionObserver(
					(entries) => {
						const visibleEntries = entries.filter((entry) => entry.isIntersecting);
						if (visibleEntries.length > 0) {
							visibleEntries.sort(
								(a, b) => a.boundingClientRect.top - b.boundingClientRect.top
							);
							activeSlug = visibleEntries[0].target.id;
							updateActive();
						}
					},
					{
						rootMargin: '-80px 0px -60% 0px',
						threshold: 0,
					}
				);

				headingElements.forEach((heading) => observer.observe(heading));

				function updateActive() {
					tocLinks.forEach((link) => {
						if (link.dataset.tocSlug === activeSlug) {
							link.classList.add('is-active');
						} else {
							link.classList.remove('is-active');
						}
					});
				}
			}

			setupTocSpy();
			document.addEventListener('astro:page-load', setupTocSpy);
		</script>
	</body>
</html>
