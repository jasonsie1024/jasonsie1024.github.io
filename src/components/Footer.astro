---
import ScrollToTop from './ScrollToTop.astro';

const today = new Date();
---

<footer>
	<div class="footer-content">
		<p class="copyright">@ {today.getFullYear()} Jason Sie.</p>
		<div class="links">
			<a href="/rss.xml">RSS</a>
		</div>
	</div>
</footer>

<ScrollToTop />

<style>
	footer {
		width: 100%;
		margin: 0;
		padding: 2.5rem 0 4.5rem;
		border: none;
		color: var(--text-muted);
		font-size: 0.88rem;
	}
	.footer-content {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 0 1.5rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
	}
	.copyright {
		margin: 0;
	}
	.links {
		display: flex;
		gap: 1.4rem;
	}
	.links a {
		color: var(--text-muted);
		text-decoration: none;
		transition: opacity 0.15s ease;
	}
	.links a:hover {
		opacity: 0.8;
	}
</style>
