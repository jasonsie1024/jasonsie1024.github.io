---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: string | ImageMetadata;
	alt?: string;
	caption?: string;
	class?: string;
}

const { src, alt, caption, class: className } = Astro.props;
const displayAlt = alt || caption || '';
---

<figure class:list={['content-figure', className]}>
	{
		typeof src === 'string' ? (
			<img src={src} alt={displayAlt} loading="lazy" decoding="async" />
		) : (
			<Image src={src} alt={displayAlt} />
		)
	}
	{caption && <figcaption class="content-figcaption">{caption}</figcaption>}
</figure>

<style>
	.content-figure {
		margin: 2.8rem 0;
		padding: 0;
		text-align: center;
	}
	.content-figure img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0;
		margin: 0 auto;
		cursor: pointer;
	}
	.content-figcaption {
		margin-top: 0.85rem;
		font-size: 0.85rem;
		color: var(--text-muted);
		letter-spacing: 0.04em;
		line-height: 1.6;
		text-align: right;
	}

	@media (max-width: 640px) {
		.content-figure {
			margin: 2rem 0;
		}
		.content-figcaption {
			font-size: 0.82rem;
			margin-top: 0.65rem;
		}
	}
</style>

