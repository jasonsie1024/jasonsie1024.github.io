---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<div class="site-brand">
			<a href="/" class="brand-link">{SITE_TITLE}</a>
		</div>
		<div class="internal-links">
			<HeaderLink href="/">首頁</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/tags">標籤</HeaderLink>
			<HeaderLink href="/about">關於</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		width: 100%;
		margin: 0;
		padding: 3.5rem 0 1rem;
		border: none;
	}
	nav {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 0 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
	}
	.brand-link {
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--text);
		text-decoration: none;
		letter-spacing: 0.04em;
		transition: opacity 0.15s ease;
	}
	.brand-link:hover {
		opacity: 0.8;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.8rem;
	}
</style>
