---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, filterDrafts } from '../consts';

const posts = (await getCollection('blog', filterDrafts)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const recentPosts = posts.slice(0, 10);
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.section-header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: 2rem;
				border: none;
				padding-bottom: 0;
			}
			.section-header h2 {
				margin: 0;
				font-size: 1.4rem;
			}
			.view-all {
				font-size: 0.9rem;
				color: var(--text-muted);
				text-decoration: none;
				transition: opacity 0.15s ease;
			}
			.view-all:hover {
				opacity: 0.8;
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.post-item {
				margin-bottom: 3.5rem;
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
			}
			.post-thumb-link {
				display: block;
				margin-top: 0.8rem;
				margin-bottom: 0.6rem;
				text-decoration: none;
			}
			.post-thumb {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 0;
				transition: opacity 0.2s ease;
			}
			.post-thumb-link:hover .post-thumb {
				opacity: 0.85;
			}
			.post-link {
				color: var(--text);
				text-decoration: none;
				font-size: 1.2rem;
				font-weight: 600;
				transition: opacity 0.15s ease;
			}
			.post-link:hover {
				opacity: 0.8;
			}
			.post-meta {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.8rem;
				font-size: 0.88rem;
				color: var(--text-muted);
			}
			.draft-badge {
				font-size: 0.75rem;
				border: 1px solid var(--border);
				padding: 0.1em 0.4em;
				border-radius: 2px;
				color: var(--text-muted);
			}
			.tags {
				display: flex;
				gap: 0.6rem;
			}
			.tag-link {
				color: var(--text-muted);
				text-decoration: none;
				font-size: 0.85rem;
				transition: opacity 0.15s ease;
			}
			.tag-link:hover {
				opacity: 0.8;
			}
			.post-desc {
				font-size: 0.96rem;
				color: var(--text-muted);
				margin: 0.2rem 0 0;
				line-height: 1.65;
			}
			.empty-state {
				color: var(--text-muted);
				padding: 2rem 0;
			}

			@media (max-width: 640px) {
				.section-header {
					margin-bottom: 1.5rem;
				}
				.section-header h2 {
					font-size: 1.25rem;
				}
				.post-item {
					margin-bottom: 2.6rem;
				}
				.post-thumb-link {
					margin-top: 0.6rem;
					margin-bottom: 0.4rem;
				}
				.post-link {
					font-size: 1.1rem;
				}
				.post-desc {
					font-size: 0.92rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="recent-posts">
				<div class="section-header">
					<h2>近期文章</h2>
					{recentPosts.length > 0 && <a href="/blog" class="view-all">閱讀全部 →</a>}
				</div>
				{
					recentPosts.length === 0 ? (
						<p class="empty-state">尚無發布的文章。</p>
					) : (
						<ul class="post-list">
							{recentPosts.map((post) => (
								<li class="post-item">
									<a href={`/blog/${post.id}/`} class="post-link">
										{post.data.title}
									</a>
									<div class="post-meta">
										<FormattedDate date={post.data.pubDate} />
										{post.data.draft && <span class="draft-badge">草稿</span>}
										{post.data.tags && post.data.tags.length > 0 && (
											<div class="tags">
												{post.data.tags.map((tag: string) => (
													<a href={`/tags/${tag}`} class="tag-link">
														#{tag}
													</a>
												))}
											</div>
										)}
									</div>
									{post.data.heroImage && (
										<a href={`/blog/${post.id}/`} class="post-thumb-link" tabindex="-1" aria-hidden="true">
											<Image src={post.data.heroImage} alt="" class="post-thumb" />
										</a>
									)}
									{post.data.description && (
										<p class="post-desc">{post.data.description}</p>
									)}
								</li>
							))}
						</ul>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
