---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, filterDrafts } from '../../consts';

const posts = (await getCollection('blog', filterDrafts)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const allTags = [...new Set(posts.flatMap((post) => post.data.tags || []))];
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead title={`所有文章 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.page-title {
				margin-top: 0;
				margin-bottom: 1.5rem;
				font-size: 1.85rem;
				border: none;
				padding-bottom: 0;
			}
			.tag-bar {
				display: flex;
				flex-wrap: wrap;
				gap: 0.8rem;
				margin-bottom: 2.8rem;
			}
			.tag-pill {
				color: var(--text-muted);
				text-decoration: none;
				font-size: 0.9rem;
				transition: opacity 0.15s ease;
			}
			.tag-pill:hover {
				opacity: 0.8;
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.post-item {
				margin-bottom: 3.5rem;
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
			}
			.post-thumb-link {
				display: block;
				margin-top: 0.8rem;
				margin-bottom: 0.6rem;
				text-decoration: none;
			}
			.post-thumb {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 0;
				transition: opacity 0.2s ease;
			}
			.post-thumb-link:hover .post-thumb {
				opacity: 0.85;
			}
			.post-link {
				color: var(--text);
				text-decoration: none;
				font-size: 1.25rem;
				font-weight: 600;
				line-height: 1.4;
				transition: opacity 0.15s ease;
			}
			.post-link:hover {
				opacity: 0.8;
			}
			.post-meta {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.8rem;
				font-size: 0.88rem;
				color: var(--text-muted);
			}
			.draft-badge {
				font-size: 0.75rem;
				border: 1px solid var(--border);
				padding: 0.1em 0.4em;
				border-radius: 2px;
				color: var(--text-muted);
			}
			.tags {
				display: flex;
				gap: 0.6rem;
			}
			.tag-link {
				color: var(--text-muted);
				text-decoration: none;
				font-size: 0.85rem;
				transition: opacity 0.15s ease;
			}
			.tag-link:hover {
				opacity: 0.8;
			}
			.post-desc {
				font-size: 0.96rem;
				color: var(--text-muted);
				margin: 0.2rem 0 0;
				line-height: 1.65;
			}

			@media (max-width: 640px) {
				.page-title {
					font-size: 1.6rem;
					margin-bottom: 1.2rem;
				}
				.tag-bar {
					margin-bottom: 2rem;
				}
				.post-item {
					margin-bottom: 2.6rem;
				}
				.post-thumb-link {
					margin-top: 0.6rem;
					margin-bottom: 0.4rem;
				}
				.post-link {
					font-size: 1.12rem;
				}
				.post-desc {
					font-size: 0.92rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">所有文章</h1>

			{allTags.length > 0 && (
				<nav class="tag-bar" aria-label="標籤導覽">
					{allTags.map((tag) => (
						<a href={`/tags/${tag}`} class="tag-pill">
							#{tag}
						</a>
					))}
				</nav>
			)}

			{
				posts.length === 0 ? (
					<p class="empty-state">尚無發布的文章。</p>
				) : (
					<ul class="post-list">
						{posts.map((post) => (
							<li class="post-item">
								<a href={`/blog/${post.id}/`} class="post-link">
									{post.data.title}
								</a>
								<div class="post-meta">
									<FormattedDate date={post.data.pubDate} />
									{post.data.draft && <span class="draft-badge">草稿</span>}
									{post.data.tags && post.data.tags.length > 0 && (
										<div class="tags">
											{post.data.tags.map((tag: string) => (
												<a href={`/tags/${tag}`} class="tag-link">
													#{tag}
												</a>
											))}
										</div>
									)}
								</div>
								{post.data.heroImage && (
									<a href={`/blog/${post.id}/`} class="post-thumb-link" tabindex="-1" aria-hidden="true">
										<Image src={post.data.heroImage} alt="" class="post-thumb" />
									</a>
								)}
								{post.data.description && (
									<p class="post-desc">{post.data.description}</p>
								)}
							</li>
						))}
					</ul>
				)
			}
		</main>
		<Footer />
	</body>
</html>
